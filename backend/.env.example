# KISAN AI - Backend Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# ✅ REQUIRED - Application will not start without these
# ============================================================================

# Server Configuration
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kisanaico
DB_USER=root
DB_PASSWORD=your_secure_password_here

# JWT Secrets (use strong, random values - minimum 32 characters)
JWT_ACCESS_SECRET=your_secure_access_token_min_32_chars_xxxxxxxxxx
JWT_REFRESH_SECRET=your_secure_refresh_token_min_32_chars_xxxxxxxxx

# External AI & Weather APIs
GROQ_API_KEY=gsk_your_key_from_console_groq_com
OPENWEATHER_API_KEY=your_key_from_openweathermap_org

# ============================================================================
# ⚠️  RECOMMENDED - Enable external services for full functionality
# ============================================================================

# Firebase Cloud Messaging (Push Notifications)
# Get this from: https://console.firebase.google.com
# Download service account JSON and paste here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----..."}

# Email Notifications (Nodemailer)
# Configure SMTP server for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_or_smtp_password
SMTP_FROM=noreply@kisanai.com

# SMS Notifications (Twilio)
# Get account at: https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_token_xxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Agricultural Market Data APIs
# AGMARKNET API from: https://data.gov.in
AGMARKNET_API_KEY=your_api_key_from_data_gov_in

# ============================================================================
# 🔧 OPTIONAL - Only needed if using these features
# ============================================================================

# Image Upload Service (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Decentralized Storage (IPFS via Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret

# Blockchain (Ethereum Sepolia Testnet)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_prefix
CONTRACT_ADDRESS=0x373f1A638AEbAE8AdEe69Fb9d90F20dDE3FB8580

# Translation Service (LibreTranslate)
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_KEY=your_key_if_using_private_instance

# News APIs (pick one or both)
NEWSAPI_KEY=your_newsapi_key
GNEWS_API_KEY=your_gnews_api_key

# ============================================================================
# 📝 NOTES
# ============================================================================
# 1. NEVER commit real .env file to git - use .env.example as template
# 2. Use environment-specific secrets in production
# 3. Ensure database user has proper permissions
# 4. Test each service with its corresponding API key
# 5. Keep JWT secrets complex and change them periodically
