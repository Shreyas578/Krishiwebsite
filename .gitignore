yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
*.log
temp/
tmp/
.vercel/

# =========================
# Environment Variables (CRITICAL)
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
credentials.json
client_secret.json

# =========================
# React / Vite Frontend (/web)
# =========================
web/node_modules/
web/dist/
web/build/
web/.eslintcache
web/dist-ssr/
web/*.local

# =========================
# Node.js / Express Backend (/backend)
# =========================
backend/node_modules/
backend/dist/
backend/build/
backend/coverage/
backend/pids
backend/*.pid
backend/*.seed
backend/*.pid.lock
backend/artifacts/
backend/cache/
backend/uploads/
backend/temp_receipt_*.html

